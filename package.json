{
  "name": "usability-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed UX audits. v0 slice 1: capture -> heuristics -> annotated results page.",
  "scripts": {
    "audit": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "test:hooks": "sh src/hooks.test.sh",
    "snapshot": "node --import tsx src/snapshot.ts",
    "fixtures": "node --import tsx src/fixtures.ts",
    "signals": "node --import tsx src/signals-report.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" && sh src/hooks.test.sh",
    "check": "npm run typecheck && npm test && npm run snapshot -- check",
    "corpus": "node --import tsx src/corpus-build.ts",
    "outcome": "node --import tsx src/outcome.ts",
    "label": "node --import tsx src/label.ts",
    "review": "node --import tsx src/review.ts",
    "reaudit": "node --env-file-if-exists=.env --import tsx src/reaudit.ts",
    "funnel": "node --import tsx src/funnel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "^12.2.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
